[Unit]
Description=MedTender AI Agent one-shot monitoring run
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=medtender
Group=medtender
WorkingDirectory=/opt/medtender-agent
EnvironmentFile=/opt/medtender-agent/.env
ExecStart=/opt/medtender-agent/.venv/bin/python -m app.main run
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/medtender-agent/data

[Install]
WantedBy=multi-user.target
